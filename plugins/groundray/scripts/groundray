#!/bin/sh
set -eu

plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
if [ -n "${GROUNDRAY_CLI:-}" ]; then
    cli=$GROUNDRAY_CLI
elif [ -e "${plugin_root}/runtime" ] || [ -L "${plugin_root}/runtime" ] \
    || [ -e "${plugin_root}/.bundled-runtime" ]; then
    if [ -L "${plugin_root}/runtime" ] || [ -L "${plugin_root}/runtime/groundray" ] \
        || [ -L "${plugin_root}/runtime/SHA256SUMS" ] \
        || [ ! -f "${plugin_root}/runtime/groundray" ] \
        || [ ! -x "${plugin_root}/runtime/groundray" ] \
        || [ ! -f "${plugin_root}/runtime/SHA256SUMS" ]; then
        echo 'error: bundled Groundray runtime is incomplete or unsafe.' >&2
        exit 1
    fi
    entry=$(cat "${plugin_root}/runtime/SHA256SUMS")
    expected=${entry%  groundray}
    if [ "$entry" != "$expected  groundray" ] || [ "${#expected}" -ne 64 ]; then
        echo 'error: bundled runtime checksum must identify exactly groundray.' >&2
        exit 1
    fi
    case "$expected" in
        *[!0-9a-f]*) echo 'error: invalid bundled runtime SHA-256.' >&2; exit 1 ;;
    esac
    if command -v sha256sum >/dev/null 2>&1; then
        actual=$(cd "${plugin_root}/runtime" && sha256sum groundray)
    elif command -v shasum >/dev/null 2>&1; then
        actual=$(cd "${plugin_root}/runtime" && shasum -a 256 groundray)
    else
        echo 'error: sha256sum or shasum is required to check the bundled runtime.' >&2
        exit 1
    fi
    if [ "${actual%% *}" != "$expected" ]; then
        echo 'error: bundled Groundray runtime checksum mismatch.' >&2
        exit 1
    fi
    cli="${plugin_root}/runtime/groundray"
else
    cli=$(command -v groundray || true)
fi
if [ -z "$cli" ] || [ ! -f "$cli" ] || [ ! -x "$cli" ]; then
    echo 'error: Groundray needs its bundled compatible CLI or an explicitly installed groundray.' >&2
    exit 1
fi
if [ "$cli" -ef "$0" ]; then
    echo 'error: Groundray helper resolved itself; set GROUNDRAY_CLI to the standalone executable.' >&2
    exit 1
fi

if [ "${1:-}" = check ]; then
    # Release runtimes inspect the registered command tree in one launch.
    # Source-only development runtimes can use the explicit capability probes.
    if compatible=$("$cli" plugin-check 2>/dev/null); then
        case "$compatible" in
            'Groundray CLI compatible: groundray 0.3.'*)
                patch=${compatible#Groundray CLI compatible: groundray 0.3.}
                case "$patch" in
                    ''|*[!0-9]*) ;;
                    *) printf '%s\n' "$compatible"; exit 0 ;;
                esac
                ;;
        esac
    fi
    version=$("$cli" --version)
    case "$version" in
        'groundray 0.3.'*)
            patch=${version#groundray 0.3.}
            case "$patch" in
                ''|*[!0-9]*) echo "error: invalid CLI version: ${version}" >&2; exit 1 ;;
            esac
            ;;
        *) echo "error: unsupported Groundray CLI version: ${version}" >&2; exit 1 ;;
    esac
    for pair in 'source capture' 'source get' 'brain attach' 'brain propose' \
        'brain review' 'brain review-source' 'brain accept' 'knowledge create' \
        'knowledge update' 'knowledge move'; do
        first=${pair%% *}
        second=${pair#* }
        if ! "$cli" "$first" "$second" --help >/dev/null 2>&1; then
            echo "error: ${version} lacks required command: ${pair}" >&2
            exit 1
        fi
    done
    printf 'Groundray CLI compatible: %s\n' "$version"
    exit 0
fi
exec "$cli" "$@"
